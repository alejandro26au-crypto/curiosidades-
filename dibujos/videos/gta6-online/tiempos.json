  ],
  [
   400,
   501,
   "GTA 5 salió el 17 de septiembre de 2013."
  ],
  [
   520,
   646,
   "El 1 de octubre, millones de jugadores ya recorrían Los Santos con sus amigos."
  ],
  [
   662,
   718,
   "Pero esas prisas tuvieron un precio."
  ],
  [
   737,
   787,
